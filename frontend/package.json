{
  "name": "netwick-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "node scripts/lint-security.mjs && node scripts/check-i18n.mjs && tsc --noEmit",
